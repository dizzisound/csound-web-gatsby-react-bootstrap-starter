#N canvas 839 57 900 620 12;
#X text 20 10 OSC example for the Random Spline Waves page: start the bridge with npm run osc-bridge then click Connect OSC in the page. Needs Pd vanilla 0.48 or newer.;
#X obj 20 70 loadbang;
#X msg 20 100 disconnect \, connect localhost 41234;
#X text 330 100 same machine as the bridge (or WSL with mirrored networking);
#X msg 20 130 disconnect \, connect 172.18.92.169 41234;
#X text 330 130 Pd on Windows and the bridge in WSL (NAT): edit to the address the bridge prints with --host 0.0.0.0;
#X msg 20 160 disconnect;
#X obj 20 520 netsend -u -b;
#X obj 20 490 list trim;
#X obj 20 460 list prepend send;
#X text 20 200 notes: on/off MIDI-key velocity;
#X msg 20 225 1 60 100;
#X msg 110 225 0 60 0;
#X msg 190 225 1 64 100;
#X msg 280 225 0 64 0;
#X obj 20 265 oscformat rsw note;
#X text 450 200 widgets (sent while you drag);
#X obj 450 235 hsl 160 18 0 1 0 0 empty empty weight -2 -9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 450 260 oscformat rsw weight;
#X obj 450 305 hsl 160 18 0 1 0 0 empty empty amp -2 -9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 450 330 oscformat rsw amp;
#X obj 450 375 hsl 160 18 0 3.99 0 0 empty empty xy_x -2 -9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 450 400 oscformat rsw xy num1;
#X obj 680 235 tgl 18 0 empty empty adsr_on 24 9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 680 260 oscformat rsw adsr1;
#X obj 20 550 print bridge-connected;
#X text 230 520 1 = UDP socket open. UDP cannot tell whether the bridge receives: check the bridge's --verbose log.;
#X connect 1 0 2 0;
#X connect 2 0 7 0;
